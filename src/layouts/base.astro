---
const { title } = Astro.props;
import TopBar from '../components/topBar/TopBar.svelte';
import SidePanel from '../components/sidePanel/SidePanel.svelte';
import ContentTab from '../components/contentTab/ContentTab.svelte';
import CookieHandler from '../CookieHandler.svelte';
import AboutMePanel from '../components/aboutMe/AboutMePanel.svelte';

// todo plan for resolution support :
// constrain content width to 16:9 resolution to not break on UW and absurd resolutions
// make separate mobile layout

// todo credits for fonts etc
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
	</head>
	<body>
		<CookieHandler client:load />

		<TopBar client:load />
		<div class="top-container">
			<SidePanel client:load />
			<ContentTab client:load>
				<slot client:load />
			</ContentTab>
			<AboutMePanel client:load />
		</div>
	</body>

	<style is:global>
		html {
			height: 100vh;
			overflow: hidden;
			margin: 0;
		}
		body {
			background-color: black;
			background-image: url('/background.jpg');
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
			margin: 0;
			display: flex;
			flex-direction: column;
			height: 100%;
			overflow: hidden;
		}

		.top-container {
			flex: 1;
			display: flex;
			flex-direction: row;
			margin-left: 1vh;
			margin-bottom: 1vh;
			margin-right: 1vh;
			min-height: 0;
			box-sizing: border-box;
		}

		@font-face {
			font-family: 'SpaceGrotesk';
			src: url('/fonts/SpaceGrotesk-VariableFont_wght.ttf') format('truetype');
			font-weight: 300 700;
			font-display: swap;
		}

		@font-face {
			font-family: 'SpaceMono';
			src: url('/fonts/SpaceMono-Regular.ttf') format('truetype');
			font-weight: 400;
			font-display: swap;
		}

		@font-face {
			font-family: 'NerdFonts';
			src: url('/fonts/SymbolsNerdFont-Regular.ttf') format('truetype');
			font-weight: 400;
			font-display: swap;
		}

		button {
			cursor: pointer;
		}
	</style>
</html>
